{
  "name": "ringers-desktop",
  "productName": "Ringers",
  "version": "1.3.1",
  "description": "Championship horseshoe pitching in full 3D.",
  "author": "Ringers",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node prepare.cjs",
    "start": "node prepare.cjs && electron .",
    "dist:win": "node prepare.cjs && electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.ringers.horseshoes",
    "productName": "Ringers",
    "copyright": "Ringers",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "main.cjs",
      "app/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ringers",
      "artifactName": "Ringers-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Ringers-${version}-portable.exe"
    }
  }
}
